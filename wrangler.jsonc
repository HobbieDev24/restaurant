{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "restaurant-app",
  "main": "./.output/server/index.mjs",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./.output/public"
  }
}